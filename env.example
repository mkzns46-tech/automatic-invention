const SUPABASE_URL=process.env.SUPABASE_URL||"https://ihsbkknysozkstvylqff.supabase.co";
const SUPABASE_KEY=process.env.SUPABASE_API_KEY||process.env.SUPABASE_ANON_KEY||"sb_publishable_8f005IzGsMeOZktqtNtTRQ_ms6bzvze";

function cleanEnv(value){
  let cleaned=String(value||"").replace(/^\uFEFF/,"").trim();
  if((cleaned.startsWith('"')&&cleaned.endsWith('"'))||(cleaned.startsWith("'")&&cleaned.endsWith("'"))){
    cleaned=cleaned.slice(1,-1).trim();
  }
  return cleaned;
}

function required(name){
  const value=cleanEnv(process.env[name]);
  if(!value)throw new Error(`Vercel環境変数 ${name} を設定してください。`);
  return value;
}

function prefix(value,length=6){
  return value ? `${value.slice(0,length)}...` : "(empty)";
}

async function readJson(res,label){
  const text=await res.text();
  let body=null;
  try{body=text?JSON.parse(text):null;}catch{body=text;}
  if(!res.ok){
    const detail=typeof body==="string"?body:JSON.stringify(body);
    throw new Error(`${label}に失敗しました (${res.status}) ${detail||""}`);
  }
  return body;
}

async function supabase(path,opt={}){
  return readJson(await fetch(`${SUPABASE_URL.replace(/\/+$/,"")}/rest/v1/${path}`,{
    ...opt,
    headers:{
      apikey:SUPABASE_KEY,
      Authorization:`Bearer ${SUPABASE_KEY}`,
      "Content-Type":"application/json",
      Accept:"application/json",
      ...(opt.headers||{})
    }
  }),"Supabase処理");
}

async function smaregiFetch(base,token,path,params={},debugContext={}){
  const url=new URL(`${base}${path}`);
  Object.entries(params).forEach(([key,value])=>{
    if(value!==undefined&&value!==null&&value!=="")url.searchParams.set(key,String(value));
  });
  const stockDebug=path==="/stock" ? {
    request_url:url.toString(),
    upd_date_time_from:url.searchParams.get("upd_date_time_from"),
    upd_date_time_to:url.searchParams.get("upd_date_time_to"),
    store_id:url.searchParams.get("store_id"),
    SMAREGI_ENV:debugContext.SMAREGI_ENV||"",
    token_url:debugContext.token_url||""
  } : null;
  if(stockDebug)console.log("[smaregi-stock-request]",stockDebug);
  try{
    return await readJson(await fetch(url,{headers:{Authorization:`Bearer ${token}`,Accept:"application/json"}}),`スマレジAPI ${path}`);
  }catch(error){
    if(stockDebug){
      console.log("[smaregi-stock-error]",{...stockDebug,error:error.message||String(error)});
      throw new Error(`${error.message||String(error)}\n送信URL: ${stockDebug.request_url}\nupd_date_time_from: ${stockDebug.upd_date_time_from}\nupd_date_time_to: ${stockDebug.upd_date_time_to}\nstore_id: ${stockDebug.store_id}\nSMAREGI_ENV: ${stockDebug.SMAREGI_ENV}\ntoken_url: ${stockDebug.token_url}`);
    }
    throw error;
  }
}

async function fetchAll(base,token,path,params={},debugContext={}){
  const all=[];
  for(let page=1;page<=100;page++){
    const rows=await smaregiFetch(base,token,path,{...params,limit:1000,page},debugContext);
    if(!Array.isArray(rows))throw new Error(`スマレジAPI ${path} の応答形式が不正です。`);
    all.push(...rows);
    if(rows.length<1000)break;
  }
  return all;
}

function splitDateRanges(from,to){
  const ranges=[];
  let start=new Date(from);
  const end=new Date(to);
  while(start<end){
    const next=new Date(Math.min(end.getTime(),start.getTime()+30*24*60*60*1000));
    ranges.push([formatSmaregiDate(start),formatSmaregiDate(next)]);
    start=next;
  }
  return ranges;
}

function formatSmaregiDate(value){
  const date=new Date(value);
  if(Number.isNaN(date.getTime()))throw new Error(`スマレジAPIへ渡す日時が不正です: ${value}`);
  const jst=new Date(date.getTime()+9*60*60*1000);
  const pad=number=>String(number).padStart(2,"0");
  return `${jst.getUTCFullYear()}-${pad(jst.getUTCMonth()+1)}-${pad(jst.getUTCDate())}T${pad(jst.getUTCHours())}:${pad(jst.getUTCMinutes())}:${pad(jst.getUTCSeconds())}+09:00`;
}

async function mapLimit(rows,limit,fn){
  const results=new Array(rows.length);
  let cursor=0;
  async function worker(){
    while(cursor<rows.length){
      const index=cursor++;
      results[index]=await fn(rows[index],index);
    }
  }
  await Promise.all(Array.from({length:Math.min(limit,rows.length)},worker));
  return results;
}

async function fetchChanges(base,token,productId,storeId,since){
  const rows=[];
  for(let page=1;page<=10;page++){
    const part=await smaregiFetch(base,token,`/stock/changes/${encodeURIComponent(productId)}/${encodeURIComponent(storeId)}`,{
      sort:"updDateTime:desc",limit:1000,page
    });
    if(!Array.isArray(part))break;
    const current=part.filter(row=>new Date(row.updDateTime)>=new Date(since));
    rows.push(...current);
    if(part.length<1000||current.length<part.length)break;
  }
  return rows;
}

async function fetchChangesSafely(base,token,productId,storeId,since){
  try{
    return {rows:await fetchChanges(base,token,productId,storeId,since),warning:""};
  }catch(error){
    return {
      rows:[],
      warning:`在庫変動履歴は取得できませんでした。前回チェック以降の商品抽出は在庫一覧の更新日時で継続します。詳細: ${error.message||String(error)}`
    };
  }
}

module.exports=async function handler(req,res){
  if(req.method!=="POST")return res.status(405).json({error:"POSTのみ利用できます。"});
  try{
    const contractId=required("SMAREGI_CONTRACT_ID");
    const clientId=required("SMAREGI_CLIENT_ID");
    const clientSecret=required("SMAREGI_CLIENT_SECRET");
    const storeId=required("SMAREGI_STORE_ID");
    const configuredEnv=cleanEnv(process.env.SMAREGI_ENV).toLowerCase();
    if(configuredEnv&&!["sandbox","production"].includes(configuredEnv)){
      throw new Error("Vercel環境変数 SMAREGI_ENV は sandbox または production を指定してください。");
    }
    const sandbox=configuredEnv ? configuredEnv==="sandbox" : contractId.startsWith("sb_");
    const idBase=sandbox?"https://id.smaregi.dev":"https://id.smaregi.jp";
    const apiBase=`${sandbox?"https://api.smaregi.dev":"https://api.smaregi.jp"}/${encodeURIComponent(contractId)}/pos`;
    const tokenUrl=`${idBase}/app/${encodeURIComponent(contractId)}/token`;
    const scope="pos.stock:read pos.products:read pos.stock-changes:read";
    const tokenBody=new URLSearchParams({grant_type:"client_credentials",scope});
    const authDebug={
      environment:sandbox?"sandbox":"production",
      environment_source:configuredEnv?"SMAREGI_ENV":"SMAREGI_CONTRACT_ID prefix",
      token_url:tokenUrl,
      contract_id_prefix:prefix(contractId),
      client_id_prefix:prefix(clientId),
      client_id_length:clientId.length,
      client_secret_length:clientSecret.length
    };
    console.info("[smaregi-auth]",authDebug);
    let tokenData;
    try{
      tokenData=await readJson(await fetch(tokenUrl,{
        method:"POST",
        headers:{
          Authorization:`Basic ${Buffer.from(`${clientId}:${clientSecret}`,"utf8").toString("base64")}`,
          "Content-Type":"application/x-www-form-urlencoded"
        },
        body:tokenBody.toString()
      }),"スマレジOAuth認証");
    }catch(error){
      console.error("[smaregi-auth-error]",{...authDebug,error:error.message||String(error)});
      throw new Error(`${error.message||String(error)}\n認証先: ${tokenUrl}\n環境: ${authDebug.environment} (${authDebug.environment_source})\n契約ID先頭: ${authDebug.contract_id_prefix}\nCLIENT_ID先頭: ${authDebug.client_id_prefix}\nCLIENT_ID文字数: ${authDebug.client_id_length}\nCLIENT_SECRET文字数: ${authDebug.client_secret_length}\nVercel環境変数の環境、本番/サンドボックスの組み合わせ、余分な引用符・改行、シークレット再発行後の値を確認してください。`);
    }
    const token=tokenData.access_token;
    if(!token)throw new Error("スマレジOAuth認証でアクセストークンを取得できませんでした。");

    const completed=await supabase("smaregi_stock_snapshots?select=completed_at&completed_at=not.is.null&order=completed_at.desc&limit=1");
    const now=new Date();
    const since=completed[0]?.completed_at||new Date(now.getTime()-7*24*60*60*1000);
    const changed=[];
    for(const [from,to] of splitDateRanges(formatSmaregiDate(since),formatSmaregiDate(now))){
      console.log({
        upd_date_time_from:from,
        upd_date_time_to:to
      });
      console.log("[smaregi-stock-range]",{
        upd_date_time_from:from,
        upd_date_time_to:to,
        store_id:storeId,
        SMAREGI_ENV:sandbox?"sandbox":"production",
        token_url:tokenUrl
      });
      changed.push(...await fetchAll(apiBase,token,"/stock",{
        store_id:storeId,
        upd_date_time_from:from,
        upd_date_time_to:to
      },{
        SMAREGI_ENV:sandbox?"sandbox":"production",
        token_url:tokenUrl
      }));
    }

    const latestByProduct=new Map();
    changed.forEach(row=>{
      const old=latestByProduct.get(String(row.productId));
      if(!old||new Date(row.updDateTime)>new Date(old.updDateTime))latestByProduct.set(String(row.productId),row);
    });
    const stockRows=[...latestByProduct.values()];
    const products=await mapLimit(stockRows,8,row=>smaregiFetch(apiBase,token,`/products/${encodeURIComponent(row.productId)}`,{
      fields:"productId,productCode,productName"
    }));
    // /stock の更新日時フィルターが変動商品の抽出条件。
    // /stock/changes は契約プランにより利用できないため、原因調査用の補助取得に留める。
    let changeResults=[];
    if(stockRows.length){
      const firstChangeResult=await fetchChangesSafely(apiBase,token,stockRows[0].productId,storeId,since);
      if(firstChangeResult.warning){
        changeResults=stockRows.map(()=>({rows:[],warning:firstChangeResult.warning}));
      }else{
        const remaining=await mapLimit(stockRows.slice(1),4,row=>fetchChangesSafely(apiBase,token,row.productId,storeId,since));
        changeResults=[firstChangeResult,...remaining];
      }
    }
    const changes=changeResults.map(result=>result.rows);
    const historyWarnings=[...new Set(changeResults.map(result=>result.warning).filter(Boolean))];
    const items=stockRows.map((stock,index)=>({
      barcode:String(products[index].productCode||products[index].productId),
      product_name:String(products[index].productName||""),
      smaregi_stock:Math.trunc(Number(stock.stockAmount||0)),
      product_id:String(stock.productId),
      store_id:String(storeId),
      latest_change_at:stock.updDateTime,
      change_count:changes[index].length
    }));

    const snapshots=await supabase("smaregi_stock_snapshots",{
      method:"POST",
      headers:{Prefer:"return=representation"},
      body:JSON.stringify([{
        source:"api",
        note:historyWarnings.length ? `スマレジAPI同期 / ${historyWarnings[0]}` : "スマレジAPI同期",
        range_from:new Date(since).toISOString(),
        range_to:now.toISOString()
      }])
    });
    const snapshot=snapshots[0];
    if(!snapshot)throw new Error("スナップショットを作成できませんでした。");
    for(let index=0;index<items.length;index+=500){
      await supabase("smaregi_stock_items",{
        method:"POST",
        headers:{Prefer:"return=minimal"},
        body:JSON.stringify(items.slice(index,index+500).map(item=>({...item,snapshot_id:snapshot.id})))
      });
    }
    const changeRows=[];
    changes.forEach((rows,index)=>{
      rows.forEach(change=>changeRows.push({
        snapshot_id:snapshot.id,
        smaregi_change_id:String(change.id),
        product_id:String(stockRows[index].productId),
        store_id:String(storeId),
        barcode:items[index].barcode,
        changed_at:change.updDateTime||change.targetDateTime||null,
        amount:Math.trunc(Number(change.amount||0)),
        stock_amount:Math.trunc(Number(change.stockAmount||0)),
        stock_division:String(change.stockDivision||""),
        memo:String(change.memo||"")
      }));
    });
    for(let index=0;index<changeRows.length;index+=500){
      await supabase("smaregi_stock_changes",{
        method:"POST",
        headers:{Prefer:"return=minimal"},
        body:JSON.stringify(changeRows.slice(index,index+500))
      });
    }
    return res.status(200).json({
      snapshot_id:snapshot.id,
      item_count:items.length,
      change_count:changes.reduce((sum,rows)=>sum+rows.length,0),
      history_available:historyWarnings.length===0,
      warning:historyWarnings[0]||"",
      range_from:new Date(since).toISOString(),
      range_to:now.toISOString(),
      initial_sync:!completed.length
    });
  }catch(error){
    return res.status(500).json({error:error.message||String(error)});
  }
};
